{
  "appId": "com.tropami.app",
  "appName": "Tropami",
  "webDir": "www",
  "server": {
    "url": "https://tropami.com/app/",
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "tropami.com",
      "www.tropami.com"
    ]
  },
  "android": {
    "backgroundColor": "#2D5843"
  },
  "ios": {
    "backgroundColor": "#2D5843",
    "contentInset": "never"
  },
  "appendUserAgent": "TropamiApp",
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
